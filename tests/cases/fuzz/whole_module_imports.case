=== reg.py
REGISTRY = {}


def register(fn):
    REGISTRY[fn.__name__] = fn
    return fn


class Plugin:
    seen = []

    def __init_subclass__(cls):
        Plugin.seen.append(cls.__name__)

    def run(self):
        return 0
