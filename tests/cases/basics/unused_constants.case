description = "constants with pure initializers are removed when unused"
removed = ["consts:B", "consts:C", "consts:D", "consts:E"]
kept = ["consts:A"]
stdout = "1\n"
=== main.py
from consts import A

print(A)
=== consts.py
A = 1
B = (1, 2, "three", None, 4.5, b"x")
C = {"k": [1, 2], "j": {3}}
D = -A + 2 * 3
E = f"{A}-x"
