description = "string annotations under 'from __future__ import annotations' still keep their names"
kept = ["lib:Point", "lib:annotations"]
stdout = "{'p': <class 'lib.Point'>}\n"
=== main.py
import typing

from lib import f

print(typing.get_type_hints(f))
=== lib.py
from __future__ import annotations


class Point:
    pass


def f(p: Point):
    return p
